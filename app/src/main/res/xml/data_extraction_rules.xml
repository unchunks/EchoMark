<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
            DB は SQLCipher で暗号化し、その鍵は端末の Keystore の外へ出ない。別の端末へ移しても開けないため、移さない
            (端末を移すときは、アプリのバックアップ(設定 → データ)で移す。#100)
        -->
        <exclude domain="database" path="." />
        <!-- API キーの暗号文は端末の Keystore 鍵でしか復号できないため復元しない -->
        <exclude domain="file" path="datastore/api_keys.preferences_pb" />
        <!-- 取り込んだオンデバイス LLM モデル(数百MB〜)はバックアップしない -->
        <exclude domain="file" path="models/" />
        <!--
            保存した画像・PDF・音声・動画は、クラウドのバックアップ(容量の上限が小さい)には入れない。
            機種変更時の端末間の転送では移す(ブックマークと一緒に見られるように)
        -->
        <exclude domain="file" path="attachments/" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <!--
            DB は SQLCipher で暗号化し、その鍵は端末の Keystore の外へ出ない。別の端末へ移しても開けないため、移さない
            (端末を移すときは、アプリのバックアップ(設定 → データ)で移す。#100)
        -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/api_keys.preferences_pb" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
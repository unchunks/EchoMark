<?xml version="1.0" encoding="utf-8"?>
<!--
  ランチャーアイコンの前景: 中央のブックマークと、左右に広がる「響き」の波紋。
  108dp 四方のうち、どの形のマスクでも欠けない中央の直径 66dp の円に収めている。
  スプラッシュ画面のアイコンにも使う。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- マスクの縁に近づきすぎないよう、全体を少し縮める -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.88"
        android:scaleY="0.88">
        <!-- 内側の波紋 -->
        <path
            android:fillColor="#00000000"
            android:pathData="M68.14,38.86A20,20 0,0 1,68.14 67.14M39.86,67.14A20,20 0,0 1,39.86 38.86"
            android:strokeWidth="3"
            android:strokeColor="#FF9CF2E8"
            android:strokeLineCap="round" />
        <!-- 外側の波紋(薄く) -->
        <path
            android:fillColor="#00000000"
            android:pathData="M73.8,33.2A28,28 0,0 1,73.8 72.8M34.2,72.8A28,28 0,0 1,34.2 33.2"
            android:strokeAlpha="0.55"
            android:strokeWidth="3"
            android:strokeColor="#FF9CF2E8"
            android:strokeLineCap="round" />
        <!-- ブックマーク -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M46.5,35h15a2.5,2.5 0,0 1,2.5 2.5v33.5l-10,-7l-10,7v-33.5a2.5,2.5 0,0 1,2.5 -2.5z" />
    </group>
</vector>

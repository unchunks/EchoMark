<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 再発見通知用。Android 13+ のみ実行時に要求する(設定でオンにしたとき) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 長い音声・動画の文字起こし(ContentExtractionWorker)をフォアグラウンドで実行する。
         Android 15+ はメディア処理(mediaProcessing)、それより前はデータ同期(dataSync)の種類を使う -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <!-- 端末内の音声認識サービス(文字起こし)に接続するため、パッケージの可視性を宣言する -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".EchoMarkApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EchoMark">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EchoMark"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 通知タップ → echomark://bookmark/{id} で詳細画面へ(Navigation のディープリンク) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="bookmark"
                    android:scheme="echomark" />
            </intent-filter>

            <!-- ランチャーのアイコン長押しで出るショートカット(URL を追加・検索・新しいチャット・AI の設定) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ui.share.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:theme="@style/Theme.EchoMark.Share"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- ホーム画面ウィジェット「EchoMark 再発見」(Jetpack Glance) -->
        <receiver
            android:name=".ui.widget.RediscoverWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_rediscover_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rediscover_widget_info" />
        </receiver>

        <!-- ML Kit の画像ラベル付け(Google Play 開発者サービス版)のモデルを、インストール時にダウンロードさせる -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ica" />

        <!-- WorkManager のフォアグラウンド実行用サービスに、文字起こしで使う種類を付ける -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
# リリース用の署名鍵の設定。このファイルを keystore.properties という名前でコピーし、値を書き換える。
# keystore.properties と鍵のファイル(.jks / .keystore)はコミットしない(.gitignore 済み)。
# 代わりに環境変数 ECHOMARK_KEYSTORE_FILE / ECHOMARK_KEYSTORE_PASSWORD / ECHOMARK_KEY_ALIAS / ECHOMARK_KEY_PASSWORD でも指定できる。

# 鍵のファイルの場所(リポジトリ直下からの相対パスか、絶対パス)
storeFile=../keys/echomark-release.jks
storePassword=
keyAlias=echomark
keyPassword=
